    },
    "Only the controls explicitly requested for this car. A target temperature starts climate automatically even if Climate Power is omitted." : {
      "comment" : "App Intent or parameter description used by Siri and Shortcuts.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
