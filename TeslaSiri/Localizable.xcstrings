    },
    "Reads a Tesla vehicle's battery health percentage, estimated degradation percentage, current usable capacity vs original new-pack capacity in kWh, estimated full-charge range at 100%, current energy remaining in kWh, lifetime energy used, phantom drain percentage, and pack voltage and module temperatures." : {
      "comment" : "App Intent or parameter description used by Siri and Shortcuts.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consulta salud y degradación de la batería del Tesla, capacidad útil frente a nueva, autonomía al 100%, energía restante, consumo en reposo, voltaje y temperaturas."
          }
        }
      }
    },
    "Reads a Tesla vehicle's total odometer mileage in miles from the latest live telemetry snapshot. Omit the vehicle parameter to inspect the user's selected car." : {
      "comment" : "App Intent or parameter description used by Siri and Shortcuts.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lee el kilometraje total del odómetro de un Tesla desde la última telemetría. Omite el vehículo para el seleccionado."
          }
        }
      }
    },
    "Reads aloud Tesla's release notes about what's new in the car's software: the release notes for the update waiting to install, or for the installed version when there's no update. Can read the notes for a specific version, or only the features about one topic, such as FSD or Navigation." : {
      "comment" : "App Intent or parameter description used by Siri and Shortcuts.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lee las novedades del software de Tesla de la actualización pendiente o de la versión instalada. Permite filtrar por versión o tema como FSD o Navegación."
          }
        }
      }
    },
    "Reads live data from the user's car (or Tesla) and answers only what was asked: battery, range, tire pressure, mileage, charging, cabin climate, or locks and open doors. Pass every topic the user asked about in one call. Returns the requested readings for follow-up questions. For where the car is, use the Locate Car tool." : {
      "comment" : "App Intent or parameter description used by Siri and Shortcuts.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lee datos en vivo del Tesla y responde solo lo solicitado: batería, autonomía, neumáticos, kilometraje, carga, clima o seguros y puertas abiertas. Pasa todos los temas solicitados en una sola llamada. Para saber dónde está el vehículo usa Localizar vehículo."
          }
        }
      }
    },
