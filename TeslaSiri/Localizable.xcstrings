        }
      }
    },
    "Set true to enable Sentry Mode security monitoring, or false to disable Sentry Mode (prompts for confirmation)." : {
      "comment" : "App Intent or parameter description used by Siri and Shortcuts.",
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "es" : {
