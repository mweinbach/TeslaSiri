    "true for Supercharger sessions only, false for AC sessions only (home or destination chargers). Leave empty for both.": {
      "comment": "App Intent or parameter description used by Siri and Shortcuts.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "True solo para Superchargers, false solo para carga CA. Déjalo vacío para ambos."
          }
        }
      }
    },
    "true to turn on Bioweapon Defense Mode (HEPA filtration with positive cabin pressure) for smoke, pollen, or bad air; false to turn it off. Leave empty to leave it unchanged. Only on cars with a HEPA filter.": {
      "comment": "App Intent or parameter description used by Siri and Shortcuts.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "True para activar Defensa Biológica (filtro HEPA), false para apagarlo. Déjalo vacío para no cambiarlo."
          }
        }
      }
    },
    "true to turn on Dog Mode, which keeps the cabin comfortable for a pet and shows a message on the screen; false to turn it off (the user is asked to confirm). Leave empty to leave it unchanged.": {
      "comment": "App Intent or parameter description used by Siri and Shortcuts.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "True para activar Modo Perro, false para apagarlo (pide confirmación). Déjalo vacío para no cambiarlo."
          }
        }
      }
    },
    "true to turn on max defrost for an icy or fogged windshield, false to turn it off. Leave empty to leave defrost unchanged.": {
      "comment": "App Intent or parameter description used by Siri and Shortcuts.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "True para activar desempañado máximo, false para apagarlo. Déjalo vacío para no cambiarlo."
          }
        }
      }
    },
    "true to turn on the heated steering wheel, false to turn it off. Leave empty to leave it unchanged. Not every Tesla has one.": {
      "comment": "App Intent or parameter description used by Siri and Shortcuts.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "True para encender la calefacción del volante, false para apagarla. Déjalo vacío para no cambiarlo."
          }
        }
      }
    },
    "true to turn the heater on, false to turn it off.": {
      "comment": "App Intent or parameter description used by Siri and Shortcuts.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "True para encender la calefacción, false para apagarla."
          }
        }
      }
    },
