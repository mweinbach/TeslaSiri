    "Version %@ on %@ has %lld release notes matching \"%@\". %@": {
      "comment": "Spoken digest of release notes matching a user search query",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Version %1$@ on %2$@ has %#@notes@ matching \"%4$@\". %5$@"
          },
          "substitutions": {
            "notes": {
              "argNum": 3,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg release note"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg release notes"
                    }
                  }
                }
              }
            }
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La versión %1$@ en %2$@ tiene %#@notes@ con «%4$@». %5$@"
          },
          "substitutions": {
            "notes": {
              "argNum": 3,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg nota que coincide"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg notas que coinciden"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "Version %@ on %@ includes %lld release notes. %@": {
      "comment": "Spoken digest of release notes for a software version",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Version %1$@ on %2$@ includes %#@notes@. %4$@"
          },
          "substitutions": {
            "notes": {
              "argNum": 3,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg release note"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg release notes"
                    }
                  }
                }
              }
            }
