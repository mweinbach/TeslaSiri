    "For %@ %@: %lld charging sessions added %@ (about %@).": {
      "comment": "Spoken charging stats headline with session count, energy, and range added",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For %1$@ %2$@: %#@sessions@ added %4$@ (about %5$@)."
          },
          "substitutions": {
            "sessions": {
              "argNum": 3,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg charging session"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg charging sessions"
                    }
                  }
                }
              }
            }
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para %1$@ %2$@: %#@sessions@ %4$@ (unos %5$@)."
          },
          "substitutions": {
