    "One sentence describing what happened, suitable to tell the user.": {
      "comment": "App Intent or parameter description used by Siri and Shortcuts.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una oración que describe lo ocurrido para informar al usuario."
          }
        }
      }
    },
    "Only include drives at least this long, in miles, such as 10.": {
      "comment": "App Intent or parameter description used by Siri and Shortcuts.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Incluir solo viajes de al menos esta distancia en millas, como 10."
          }
        }
      }
    },
    "Only include drives at most this long, in miles, such as 5 for short errands.": {
      "comment": "App Intent or parameter description used by Siri and Shortcuts.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Incluir solo viajes de como máximo esta distancia en millas, como 5."
          }
        }
      }
    },
    "Only include drives that lasted at least this many minutes, such as 30.": {
      "comment": "App Intent or parameter description used by Siri and Shortcuts.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Incluir solo viajes que duraron al menos estos minutos, como 30."
          }
        }
      }
    },
    "Only the conditions the user gave. For \"when did I last drive to the airport?\", set the destination to Airport and the maximum results to 1.": {
      "comment": "App Intent or parameter description used by Siri and Shortcuts.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo las condiciones indicadas por el usuario."
          }
        }
      }
    },
    "Only the controls explicitly requested for this car. A target temperature starts climate automatically even if Climate Power is omitted.": {
      "comment": "App Intent or parameter description used by Siri and Shortcuts.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo los controles solicitados explícitamente. Una temperatura objetivo enciende el clima automáticamente."
          }
        }
      }
    },
    "Only the front seats can be cooled. Try the driver or passenger seat.": {
      "comment": "Error message when attempting to cool rear seats.",
      "localizations": {
