{
  "sourceLanguage": "en",
  "strings": {
    "${action} charge port on ${vehicle}": {
      "comment": "App Intents parameter summary shown in the Shortcuts app.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "${action} el puerto de carga de ${vehicle}"
          }
        }
      }
    },
    "${action} charge port on my car": {
      "comment": "App Intents parameter summary shown in the Shortcuts app.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "${action} el puerto de carga de mi vehículo"
          }
        }
      }
    },
    "%@": {
      "comment": "Error wrapper passing through an already-localized or provider-returned error message.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@"
          }
        }
      }
    },
    "%@ %@": {
      "comment": "Tire position paired with its metric pressure reading.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ %2$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@"
          }
        }
      }
    },
    "%@ %@ %lld": {
      "comment": "Short step label for setting a seat heater or cooler to a numeric level.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ %2$@ %3$lld"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ %3$lld"
          }
        }
      }
    },
    "%@ %@ off": {
      "comment": "Short step label for turning a seat heater or cooler off.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ %2$@ off"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ apagado"
          }
        }
      }
    },
    "%@ %lld": {
      "comment": "Applied value summarizing seat name and climate level.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ %2$lld"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$lld"
          }
        }
      }
    },
    "%@ Autopilot": {
      "comment": "Autopilot percentage badge on drive card",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Autopilot"
          }
        }
      }
    },
    "%@ Battery Health": {
      "comment": "Battery health entity title with percentage",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ salud de batería"
          }
        }
      }
    },
    "%@ Battery Stats": {
      "comment": "Fallback battery stats entity title",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ estadísticas de batería"
          }
        }
      }
    },
    "%@ Charger": {
      "comment": "Fallback charging location title",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cargador %@"
          }
        }
      }
    },
    "%@ Location": {
      "comment": "Fallback location headline on vehicle map card",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ubicación de %@"
          }
        }
      }
    },
    "%@ Remaining": {
      "comment": "Battery stats entity title with remaining energy\nFallback headline when pack health percent is unavailable",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ restante"
          }
        }
      }
    },
    "%@ Software": {
      "comment": "Spotlight title for a vehicle's software update status",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Software de %@"
          }
        }
      }
    },
    "%@ Status": {
      "comment": "Display title for a vehicle status entity.\nSpotlight item title for a vehicle's status.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estado de %@"
          }
        }
      }
    },
    "%@ accepted: %@.": {
      "comment": "Siri confirmation listing vehicle controls accepted by the car.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ accepted: %2$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ aceptó: %2$@."
          }
        }
      }
    },
    "%@ accepted: %@. I couldn't confirm %@: %@.": {
      "comment": "Siri summary when a multi-step vehicle command partially succeeded and had no remaining skipped steps. Placeholders: vehicle name, accepted steps, failed step, error description.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ accepted: %2$@. I couldn't confirm %3$@: %4$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ aceptó: %2$@. No pude confirmar %3$@: %4$@."
          }
        }
      }
    },
    "%@ accepted: %@. I couldn't confirm %@: %@. Not sent: %@.": {
      "comment": "Siri summary when a multi-step vehicle command partially succeeded and skipped remaining steps. Placeholders: vehicle name, accepted steps, failed step, error description, skipped steps.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ accepted: %2$@. I couldn't confirm %3$@: %4$@. Not sent: %5$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ aceptó: %2$@. No pude confirmar %3$@: %4$@. No enviado: %5$@."
          }
        }
      }
    },
    "%@ at %@": {
      "comment": "Estimated full-charge range in subtitle",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ at %2$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ al %2$@"
          }
        }
      }
    },
    "%@ capacity": {
      "comment": "Usable battery capacity in subtitle",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ de capacidad"
          }
        }
      }
    },
    "%@ currently in the pack.": {
      "comment": "Spoken energy currently remaining in the battery pack",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ disponibles actualmente en la batería."
          }
        }
      }
    },
    "%@ degradation": {
      "comment": "Battery degradation percentage in subtitle",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ de degradación"
          }
        }
      }
    },
    "%@ didn't report that information. Try again once the car is awake.": {
      "comment": "Spoken fallback when requested telemetry fields are unavailable.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no informó esos datos. Inténtalo de nuevo cuando el vehículo despierte."
          }
        }
      }
    },
    "%@ has no recent tire pressure reading.": {
      "comment": "Siri fallback when tire pressure readings are unavailable.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no tiene una lectura reciente de presión de neumáticos."
          }
        }
      }
    },
    "%@ has no recorded charging sessions %@.": {
      "comment": "Spoken charging stats when no charging sessions were recorded",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ has no recorded charging sessions %2$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ no tiene cargas registradas %2$@."
          }
        }
      }
    },
    "%@ has no recorded drives %@, with %@ used while parked.": {
      "comment": "Spoken driving stats when there are no drives but idle energy was used",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ has no recorded drives %2$@, with %3$@ used while parked."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ no tiene viajes registrados %2$@, con %3$@ consumidos estacionado."
          }
        }
      }
    },
    "%@ has no recorded drives %@.": {
      "comment": "Spoken driving stats when there are no recorded drives in the period",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ has no recorded drives %2$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ no tiene viajes registrados %2$@."
          }
        }
      }
    },
    "%@ has no software update waiting.": {
      "comment": "Spoken status when no software update is pending",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no tiene ninguna actualización de software pendiente."
          }
        }
      }
    },
    "%@ hasn't reported its location recently.": {
      "comment": "Spoken location sentence when the vehicle has no recent coordinates.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no ha informado su ubicación recientemente."
          }
        }
      }
    },
    "%@ heat %lld": {
      "comment": "Short step label for setting a seat heater level.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ heat %2$lld"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "calefacción %1$@ nivel %2$lld"
          }
        }
      }
    },
    "%@ heat off": {
      "comment": "Short step label for turning a seat heater off.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "calefacción %@ apagada"
          }
        }
      }
    },
    "%@ is already up to date.": {
      "comment": "Siri response when no software update is available.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ya está actualizado."
          }
        }
      }
    },
    "%@ is at %@ (%@ range) and charging.": {
      "comment": "Siri battery readout with percentage, range, and active charging.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ is at %2$@ (%3$@ range) and charging."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ está al %2$@ (%3$@ de autonomía) y cargando."
          }
        }
      }
    },
    "%@ is at %@ (%@ range).": {
      "comment": "Siri battery readout with percentage and range.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ is at %2$@ (%3$@ range)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ está al %2$@ (%3$@ de autonomía)."
          }
        }
      }
    },
    "%@ is at %@ and charging.": {
      "comment": "Siri battery readout with percentage and active charging.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ is at %2$@ and charging."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ está al %2$@ y cargando."
          }
        }
      }
    },
    "%@ is at %@ battery.": {
      "comment": "Spoken sentence reporting battery percentage.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ is at %2$@ battery."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ tiene %2$@ de batería."
          }
        }
      }
    },
    "%@ is at %@ with about %@ of range.": {
      "comment": "Spoken vehicle status sentence combining battery percentage and estimated range.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ is at %2$@ with about %3$@ of range."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ está al %2$@ con unos %3$@ de autonomía."
          }
        }
      }
    },
    "%@ is at %@.": {
      "comment": "Siri battery readout with percentage only.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ is at %2$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ está al %2$@."
          }
        }
      }
    },
    "%@ is at an unknown battery level.": {
      "comment": "Siri battery readout when percentage is unavailable.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tiene un nivel de batería desconocido."
          }
        }
      }
    },
    "%@ is charging at an unknown battery level.": {
      "comment": "Siri battery readout when charging but percentage is unavailable.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está cargando con un nivel de batería desconocido."
          }
        }
      }
    },
    "%@ is driving at %@, at the location shown in the Wattie app.": {
      "comment": "Spoken location sentence when driving with coordinates but no street address.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ is driving at %2$@, at the location shown in the Wattie app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ está circulando a %2$@, en la ubicación mostrada en la app Wattie."
          }
        }
      }
    },
    "%@ is driving near %@ at %@.": {
      "comment": "Spoken location sentence when the vehicle is driving near a named address.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ is driving near %2$@ at %3$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ está circulando cerca de %2$@ a %3$@."
          }
        }
      }
    },
    "%@ is parked at the location shown in the Wattie app.": {
      "comment": "Spoken location sentence when parked with coordinates but no street address.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está estacionado en la ubicación mostrada en la app Wattie."
          }
        }
      }
    },
    "%@ is parked near %@.": {
      "comment": "Spoken location sentence when the vehicle is parked near a named address.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ is parked near %2$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ está estacionado cerca de %2$@."
          }
        }
      }
    },
    "%@ is up to date on %@.": {
      "comment": "Spoken status when the car is on the latest software version",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ is up to date on %2$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ está al día con la versión %2$@."
          }
        }
      }
    },
    "%@ is your default car.": {
      "comment": "Siri spoken summary when the user has a single active car. Placeholder is the car name.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ es tu vehículo predeterminado."
          }
        }
      }
    },
    "%@ lifetime energy used.": {
      "comment": "Spoken lifetime battery energy used",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ de energía usada en total."
          }
        }
      }
    },
    "%@ location": {
      "comment": "Spotlight location name for a vehicle.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "ubicación de %@"
          }
        }
      }
    },
    "%@ on Autopilot.": {
      "comment": "Spoken Autopilot distance on a drive",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ con Autopilot."
          }
        }
      }
    },
    "%@ phantom drain.": {
      "comment": "Spoken phantom battery drain percentage",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ de consumo en reposo."
          }
        }
      }
    },
    "%@ software update": {
      "comment": "Spotlight display name for a vehicle's software update",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "actualización de software de %@"
          }
        }
      }
    },
    "%@ to %@": {
      "comment": "Drive route from start address to destination address",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ to %2$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ a %2$@"
          }
        }
      }
    },
    "%@ to limit": {
      "comment": "Remaining charging duration until charge limit is reached",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ al límite"
          }
        }
      }
    },
    "%@ used": {
      "comment": "Energy used during a drive",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ usados"
          }
        }
      }
    },
    "%@ vehicle status": {
      "comment": "Spotlight display name for a vehicle's status.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "estado del vehículo %@"
          }
        }
      }
    },
    "%@ was asleep — sent the request to wake it and %@.": {
      "comment": "Spoken Siri result when a command is queued for a sleeping vehicle. First placeholder is vehicle name, second is the localized action infinitive phrase.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ was asleep — sent the request to wake it and %2$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ estaba en reposo; se envió la solicitud para despertarlo y %2$@."
          }
        }
      }
    },
    "%@ will charge at up to %lld amps.": {
      "comment": "Siri confirmation after setting charging current in amps.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ will charge at up to %#@amps@."
          },
          "substitutions": {
            "amps": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg amp"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg amps"
                    }
                  }
                }
              }
            }
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ cargará hasta a %#@amps@."
          },
          "substitutions": {
            "amps": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg amperio"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg amperios"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "%@ will install the update at %@.": {
      "comment": "Siri confirmation after scheduling a software update for a later time.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ will install the update at %2$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ instalará la actualización a las %2$@."
          }
        }
      }
    },
    "%@'s battery health is %@ (%@ estimated degradation).": {
      "comment": "Spoken battery health percentage with estimated degradation",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@'s battery health is %2$@ (%3$@ estimated degradation)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La salud de la batería de %1$@ es del %2$@ (%3$@ de degradación estimada)."
          }
        }
      }
    },
    "%@'s battery health is %@.": {
      "comment": "Spoken battery health percentage",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@'s battery health is %2$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La salud de la batería de %1$@ es del %2$@."
          }
        }
      }
    },
    "%@'s odometer is %@.": {
      "comment": "Siri readout for vehicle odometer distance.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@'s odometer is %2$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El odómetro de %1$@ marca %2$@."
          }
        }
      }
    },
    "%@'s odometer reading is unavailable.": {
      "comment": "Siri fallback when vehicle odometer distance is unavailable.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La lectura del odómetro de %@ no está disponible."
          }
        }
      }
    },
    "%@'s tire pressure: %@.": {
      "comment": "Siri readout for vehicle tire pressures.",
