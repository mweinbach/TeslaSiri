      }
    },
    "Where to go, as specific as possible: a full street address, a place name with its city such as \"Blue Bottle Coffee, Oakland\", a map link, or \"37.7749,-122.4194\".": {
      "comment": "App Intent or parameter description used by Siri and Shortcuts.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Destino lo más específico posible: dirección, lugar con ciudad, enlace de mapa o coordenadas."
          }
        }
      }
    },
    "Where to?": {
      "comment": "Siri disambiguation or confirmation prompt for an App Intent.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Adónde quieres ir?"
          }
        }
      }
    },
    "Whether Dog Mode is keeping the cabin conditioned for a pet.": {
      "comment": "App Intent or parameter description used by Siri and Shortcuts.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si el Modo Perro mantiene la cabina climatizada para una mascota."
