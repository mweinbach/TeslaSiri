        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuándo iniciar la instalación. Déjalo vacío para empezar ahora."
          }
        }
      }
    },
    "Where the car charged: a Supercharger site name, a street address, or a saved place such as Home.": {
