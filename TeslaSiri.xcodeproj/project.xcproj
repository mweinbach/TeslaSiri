  "targets": [
    {
      "name": "TeslaSiri",
      "id": "000000000000000100000000",
      "product": "Products/TeslaSiri.app",
      "product-type": "application",
      "dependencies": [
        "TeslaSiriAppIntents",
        "TeslaSiri WidgetExtension",
        "TeslaSiriCarIntents",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
        {
          "kind": "copy",
          "name": "Embed ExtensionKit Extensions",
          "bundle-base-path": "build-products-directory",
          "relative-path": "$(EXTENSIONS_FOLDER_PATH)",
        }, {
          "kind": "copy",
          "name": "Embed Foundation Extensions",
          "bundle-base-path": "plugins-directory",
        },
      ],
      "package-product-members": [
        {
          "product-name": "FleetKit",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "TeslaVehicleKit",
          "product-name": "TeslaVehicleKit",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "APP_SHORTCUTS_ENABLE_FLEXIBLE_MATCHING": "NO",
        "ASSETCATALOG_COMPILER_APPICON_NAME": "SiriTesla",
