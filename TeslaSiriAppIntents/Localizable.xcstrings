    "Turns Bioweapon Defense Mode positive-pressure HEPA cabin filtration on or off on supported Tesla vehicles. Omit the vehicle parameter to target the user's selected car.": {
      "comment": "App Intent or parameter description used by Siri and Shortcuts.",
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa o desactiva la filtración HEPA Defensa Biológica en Teslas compatibles. Omite el vehículo para el seleccionado."
          }
        }
      }
    },
    "Turns Dog Mode (pet climate keeper) on or off in a Tesla vehicle. Turning Dog Mode off requires user confirmation so a pet inside is not inadvertently left without climate control.": {
      "comment": "App Intent or parameter description used by Siri and Shortcuts.",
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa o desactiva el Modo Perro en un Tesla. Desactivarlo pide confirmación para proteger a una mascota."
          }
        }
      }
    },
    "Turns Sentry Mode exterior camera security monitoring on or off on a Tesla vehicle. Turning Sentry Mode off prompts the user for confirmation.": {
      "comment": "App Intent or parameter description used by Siri and Shortcuts.",
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa o desactiva el Modo Centinela en un Tesla. Desactivarlo solicita confirmación."
          }
        }
      }
    },
    "Turns maximum windshield and cabin defrost on or off in the user's car (or Tesla). Omit the vehicle parameter to target the user's selected car.": {
      "comment": "App Intent or parameter description used by Siri and Shortcuts.",
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa o desactiva el desempañado máximo del parabrisas y cabina. Omite el vehículo para el seleccionado."
          }
        }
      }
    },
    "Turns off cabin heating and air conditioning in the user's car (or Tesla), such as after preconditioning. Doesn't affect charging. Use Stop Tesla Charging (or Control Car) to end a charging session.": {
      "comment": "App Intent or parameter description used by Siri and Shortcuts.",
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apaga la calefacción y aire acondicionado del Tesla. No afecta a la carga."
          }
        }
      }
    },
    "Turns the heated steering wheel on or off. Turning it on also turns on the car's climate. Not every Tesla has a heated steering wheel.": {
      "comment": "App Intent or parameter description used by Siri and Shortcuts.",
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enciende o apaga la calefacción del volante (también enciende el clima). Solo en Teslas compatibles."
          }
        }
      }
    },
