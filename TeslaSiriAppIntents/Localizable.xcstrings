    "An address, coordinates, or map URL the user wants sent to the car's navigation.": {
      "comment": "App Intent or parameter description used by Siri and Shortcuts.",
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dirección, coordenadas o enlace de mapa para enviar a la navegación del vehículo."
          }
        }
      }
    },
    "Applied Summary": {
      "comment": "FleetKit Siri/Shortcuts label from SiriInteractiveSnippetIntents.",
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "es": {
