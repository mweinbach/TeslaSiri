      }
    },
    "Text to match against where a drive ended, such as \"Tahoe\" for \"when did I last drive to Tahoe?\".": {
      "comment": "App Intent or parameter description used by Siri and Shortcuts.",
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Texto para coincidir con el destino de un viaje."
          }
        }
      }
    },
    "Text to match against where a drive started OR ended, such as \"Airport\" or \"Deer Creek\". Use only when the user names a place without saying whether it was the start or the destination.": {
      "comment": "App Intent or parameter description used by Siri and Shortcuts.",
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Texto para coincidir con el origen o destino de un viaje cuando no se especifica cuál."
