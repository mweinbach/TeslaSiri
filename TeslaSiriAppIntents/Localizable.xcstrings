{
  "sourceLanguage": "en",
  "strings": {
    "${action} charge port on ${vehicle}": {},
    "${action} charge port on my car": {},
    "0 turns it off, 1 is low, 2 is medium, and 3 is high. \"Turn on my seat heater\" means 3.": {
      "comment": "App Intent or parameter description used by Siri and Shortcuts.",
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "0 lo apaga, 1 es bajo, 2 medio y 3 alto. «Calentar mi asiento» significa 3."
          }
        }
      }
    },
    "A Tesla software version such as 2026.38.1. Leave empty for the pending update, or the installed version when there's no update.": {
      "comment": "App Intent or parameter description used by Siri and Shortcuts.",
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una versión de software de Tesla, como 2026.38.1. Déjalo vacío para la actualización pendiente o la instalada."
          }
        }
      }
    },
    "A drive tag to match, such as \"Work\" or \"Commute\". Leave empty for all drives.": {
      "comment": "App Intent or parameter description used by Siri and Shortcuts.",
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una etiqueta de viaje, como «Trabajo». Déjalo vacío para incluir todos los viajes."
          }
        }
      }
    },
    "A short category or tagline for the feature.": {
      "comment": "FleetKit Siri/Shortcuts label from SoftwareUpdateEntity.",
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una categoría o subtítulo breve de la función."
          }
        }
      }
    },
    "A word to keep only matching features, such as FSD, Autopilot, Dashcam, or Navigation. Leave empty to read all the notes.": {
      "comment": "App Intent or parameter description used by Siri and Shortcuts.",
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Palabra para filtrar novedades, como FSD, Autopilot, Dashcam o Navegación. Déjalo vacío para leer todas."
          }
        }
      }
    },
    "AC": {
      "comment": "Charger type badge for AC charging\nSpotlight keyword for air conditioning",
